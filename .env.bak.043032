# PRISM local development environment (gitignored)
NODE_ENV=development

PORT=4000
DATABASE_URL=postgresql://prism_user:prism_password@localhost:5432/prism_db
REDIS_URL=redis://localhost:6379

WEBAUTHN_RP_ID=prism.local
WEBAUTHN_RP_NAME=PRISM Secure Payments
WEBAUTHN_EXPECTED_ORIGIN=https://prism.local:5173,http://localhost:5173

JWT_SECRET=Vgt41cadqFeXagcjBOGbBnv2EyqxfZyNRGXfV1_sq-E
QR_SIGNING_KEY=

# Must stay EMPTY: the frontend uses relative URLs through the Vite
# proxy, which is what keeps everything on one origin. Setting this
# would send browsers straight at :4000 and break the session cookie.
VITE_API_URL=

# ── Live Attack Lab (demo only; hard-disabled when NODE_ENV=production) ──
# Operator password for /attacks. Every attack endpoint refuses without it.
ATTACK_ADMIN_TOKEN=prism-demo-2026
# Enables the "Copy session for Attack Lab" button on Home, for the
# stolen-session scenarios. Every scenario still works without it.
ATTACK_LAB_DEMO_ENABLED=true
